{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property",
    "description": "Real estate listings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["for-sale", "for-rent", "sold"],
      "required": true,
      "default": "for-sale"
    },
    "property_type": {
      "type": "enumeration",
      "enum": ["house", "apartment", "condo", "land"],
      "required": true
    },
    "bedrooms": {
      "type": "integer",
      "min": 0
    },
    "bathrooms": {
      "type": "integer",
      "min": 0
    },
    "area_sqft": {
      "type": "integer",
      "min": 0
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "coordinates": {
      "type": "json"
    },
    "agent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent.agent",
      "inversedBy": "properties"
    }
  }
}
