# Chat RAG
# Enables the chat section on project pages (off by default until a backend exists).
NEXT_PUBLIC_CHAT_ENABLED=false
# Target FastAPI chat backend; "/" = same origin (no proxy, internal routes).
NEXT_PUBLIC_API_PROXY_TARGET=http://localhost:8000
# Chat media allowlist (images/videos) - JSON [{origin, pathPrefixes}].
# pathPrefixes must be concrete paths ending with "/" (a bare "/" is rejected).
NEXT_PUBLIC_MEDIA_ORIGINS_JSON=[{"origin":"https://thecamellia.vn","pathPrefixes":["/wp-content/uploads/","/media/"]},{"origin":"https://pub-90e3022fb09146c1a740a85f96ed5be7.r2.dev","pathPrefixes":["/camellia/"]}]
# Custom map tiles (empty = default CARTO Voyager, no API key).
NEXT_PUBLIC_MAP_TILE_URL=
